# Postgres connection string (Prisma). The schema is Postgres-only — use the
# same provider for local dev and Vercel (e.g. a free Neon Postgres pooler URL):
# postgresql://user:pass@ep-xxx-aaa-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:pass@host:5432/db?sslmode=require"
SESSION_PASSWORD="change-me-32-chars-minimum-length!!"
OWNER_EMAIL="makarimsusanto19@gmail.com"
# Email (pick one provider)
# Option A: SMTP (Gmail App Password)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
# Option B: Resend (alternative)
# RESEND_API_KEY=""
EMAIL_FROM="MAAS Workshop <noreply@maasworkshop.dev>"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Thumbnail uploads go to Vercel Blob (auto-injected on Vercel). For local dev,
# create a store token: vercel blob add-store-store-id --token <token>  (or via dashboard)
BLOB_READ_WRITE_TOKEN=""
